# macOS / Xcode / Samba
.DS_Store
._*
*.xcuserstate
xcuserdata/
DerivedData/
build/
*.ipa
*.dSYM.zip
*.dSYM

# XcodeGen 生成的工程（用 project.yml 重新生成，不入库）
WhalePet.xcodeproj/

# 编辑器
.vscode/
.idea/
*.swp

# 部署/运行期产物
Tools/deploy/*.log
*.log

# 插件本地运行时数据（令牌、访问日志）都在 ~/.dsh/whalepet，不在仓库内
node_modules/

# 其它 agent 的工作记录（不属于本仓库）
.workbuddy/

# Python（素材脚本可能产生的缓存）
__pycache__/
*.pyc
.venv/

# Dart / Flutter（跨平台客户端）
.dart_tool/
.packages
pubspec.lock
.flutter-plugins
.flutter-plugins-dependencies
Clients/**/build/
# 宠物存档与模型属于本地运行期数据，不入库
Clients/**/pet_save.json*
Clients/**/models/

# 本地更新前的备份目录（Hermes/手工更新时生成）
*.bak-*/

# 临时探针文件（测试/校验遗留）
*.probe
.wbtest
