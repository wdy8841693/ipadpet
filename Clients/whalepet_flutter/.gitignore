# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# macOS 平台目录里由 flutter 工具生成的部分（不入库）
macos/Flutter/ephemeral/
macos/Pods/

# 本地唤醒词（sherpa-onnx）载荷：运行时动态库 + KWS 模型。
# 由 tool/fetch_sherpa_onnx.sh 现场拉取（约 40MB），不入库；
# 构建时由 Xcode 的「Copy KWS Payload」阶段拷进 App 包的 Resources/kws/。
macos/.sherpa/

# Windows 版 sherpa-onnx 载荷：运行时 DLL + ASR/KWS 模型。
# 由 tool/fetch_sherpa_onnx_windows.py 现场拉取（运行时约 23MB，ASR 模型约 170MB），不入库。
windows/.sherpa/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Release 打包产物（用 tool/package_release.py 现场生成，不入库）
/dist/
