# WhalePet 桥接服务器环境变量样例
# 复制为 .env 或直接 export；切勿把真实 token 提交进仓库。

# ---- 必填 ----
# 客户端访问令牌（iPad 端配置同一个值）。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(24))"
WHALEPET_TOKEN=

# DeepSeek Harness 的独立 home（不要用 ~/.dsh，避免污染日常配置）。
DSH_HOME=/opt/whalepet/dsh-home

# DSH 的工作目录（智能体只能在这里读写，建议专用、纳入版本管理）。
WHALEPET_WORKSPACE=/opt/whalepet/workspace

# DeepSeek API 密钥（由 DSH 的模型适配器使用）。
DEEPSEEK_API_KEY=

# ---- 可选 ----
# 监听地址/端口（默认 0.0.0.0:8787）。
# WHALEPET_HOST=0.0.0.0
# WHALEPET_PORT=8787

# TLS（强烈建议在跨网段/不可信网络时启用；纯家庭内网可用 HTTP）。
# WHALEPET_TLS_CERT=/opt/whalepet/certs/server.pem
# WHALEPET_TLS_KEY=/opt/whalepet/certs/server.key.pem

# DSH 运行参数。
# DSH_PROFILE=sdk
# DSH_PROVIDER=deepseek-official
# DSH_MODEL=deepseek-v4-flash
# 新会话的权限预设：read-only / workspace-write（默认 read-only）。
# WHALEPET_DSH_PERMISSION=read-only
# WHALEPET_DSH_TIMEOUT_S=600

# ASR（faster-whisper）。
# WHALEPET_ASR_MODEL=small
# WHALEPET_ASR_DEVICE=cpu
# WHALEPET_ASR_COMPUTE=int8

# 唤醒词（默认"小鲸小鲸"）与同音误识别别名（逗号分隔）。
# WHALEPET_WAKE_PHRASE=小鲸小鲸
# WHALEPET_WAKE_ALIASES=小金小金,小精小精
