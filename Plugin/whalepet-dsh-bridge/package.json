{
  "name": "@dywu/whalepet-dsh-bridge",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "鲸鱼娘 DSH 局域网网关：把 iPad mini 4 上的 WhalePet 语音/文本接入本机 DSH 的 SenseVoice 与官方会话服务。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
