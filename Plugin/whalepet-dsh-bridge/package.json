{
  "name": "@dywu/whalepet-dsh-bridge",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "鲸鱼娘 DSH 局域网网关 + 设置页：旧 iPad 语音通道（/api/audio）与新跨平台文本通道（/api/agent）共用同一个 Agent 执行服务，并在 DSH 设置里提供人设/播报配置界面。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
